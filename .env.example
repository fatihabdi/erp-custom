# Salin ke .env lalu isi. Jangan commit .env.
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp
# Minimal 32 karakter acak: openssl rand -base64 48
AUTH_SECRET=
# true bila diakses lewat HTTPS (produksi di balik Caddy)
COOKIE_SECURE=false
# Akun Direktur awal (dipakai oleh db:seed)
ADMIN_NAME=Direktur
ADMIN_EMAIL=direktur@example.com
ADMIN_PASSWORD=

# --- Hanya untuk Docker Compose produksi ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=erp
# Domain publik untuk HTTPS otomatis (Caddy), mis. erp.perusahaan.co.id
DOMAIN=localhost
