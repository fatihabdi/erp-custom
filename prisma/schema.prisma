generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DIREKTUR
  ADMIN
  MARKETING
  GUDANG
  KEUANGAN
  KETUA_KAYU // Ketua Produksi Kayu
  KETUA_BESI // Ketua Produksi Besi
}

// Jenis dokumen bernomor. Penawaran (SPH) memakai tanggal terbit,
// sisanya berurutan per tahun.
enum DocType {
  SPH // Surat Penawaran Harga
  KO // Konfirmasi Order
  INV // Invoice
  KW // Kwitansi
}

// Jenis barang di gudang: bahan baku atau barang jadi.
enum ItemKind {
  RAW // bahan baku
  FINISHED // barang jadi
}

// Jenis produk di katalog: diproduksi sendiri atau dibeli jadi untuk dijual lagi.
enum ProductType {
  PRODUKSI
  DAGANG
}

enum ProductCategory {
  SEKOLAH
  KANTOR
  RUMAHAN
  LAINNYA
}

// Jenis mutasi stok. Jumlah (qty) pada StockMovement bertanda: + masuk, - keluar.
enum MovementType {
  MASUK // stok masuk manual (bahan datang, stok awal)
  KELUAR // stok keluar manual (rusak, dipakai di luar proyek)
  PENYESUAIAN // koreksi hasil hitung fisik, boleh + atau -
  PRODUKSI_MASUK // barang jadi masuk stok saat QC lulus
  PEMAKAIAN_BAHAN // bahan baku dipakai produksi (sesuai BOM)
  KIRIM // barang jadi keluar untuk pengiriman
}

model Company {
  id             String   @id @default(cuid())
  code           String   @unique // GTF, SBA
  name           String
  address        String?
  city           String? // kota penandatanganan kwitansi
  phone          String?
  email          String?
  ppnRate        Decimal  @default(0) @db.Decimal(5, 2) // GTF 0, SBA 11
  bankName       String?
  bankAccount    String?
  bankHolder     String?
  signatoryName  String?
  signatoryTitle String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users      UserCompany[]
  sequences  DocumentSequence[]
  numbers    DocumentNumber[]
  projects   Project[]
  logo       CompanyLogo?
  quotations Quotation[]
  orders     SalesOrder[]
  productionOrders ProductionOrder[]
  invoices   Invoice[]
  assets     Asset[]

  @@map("companies")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  companies UserCompany[]
  auditLogs AuditLog[]

  @@map("users")
}

// Perusahaan yang boleh diakses seorang pengguna.
model UserCompany {
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_companies")
}

// Penghitung nomor berurutan per perusahaan, jenis dokumen, dan tahun.
model DocumentSequence {
  companyId String
  docType   DocType
  year      Int
  last      Int     @default(0)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, docType, year])
  @@map("document_sequences")
}

// Nomor dokumen yang sudah terbit; unik per perusahaan dan jenis,
// dipakai untuk mendeteksi bentrok nomor di hari yang sama (akhiran -2, -3, ...).
model DocumentNumber {
  id        String   @id @default(cuid())
  companyId String
  docType   DocType
  number    String
  issuedAt  DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, docType, number])
  @@map("document_numbers")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  detail    Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// Master barang: bahan baku dan barang jadi dalam satu tabel.
// onHand adalah saldo berjalan, hanya diubah lewat mutasi (lib/inventory.ts).
model Item {
  id        String   @id @default(cuid())
  kind      ItemKind
  code      String   @unique // BB-001 (bahan baku), BJ-001 (barang jadi)
  name      String
  unit      String // unit, set, lembar, kg, meter, ...
  minStock  Decimal  @default(0) @db.Decimal(14, 3)
  // Harga pokok per satuan (rupiah), dipakai menghitung biaya bahan proyek.
  unitCost  Decimal  @default(0) @db.Decimal(16, 2)
  onHand    Decimal  @default(0) @db.Decimal(14, 3)
  notes     String?
  active    Boolean  @default(true)
  // Barang jadi menunjuk ke produk di katalog (nama, satuan, dan status aktif mengikuti produk).
  // Kosong untuk bahan baku.
  productId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements      StockMovement[]
  bomLines       BomLine[]       @relation("BomProduct")
  usedInBoms     BomLine[]       @relation("BomMaterial")
  projectLines   ProjectLine[]
  quotationLines QuotationLine[]

  @@index([kind, active])
  @@map("items")
}

// Master produk (katalog): satu baris = satu produk yang bisa dijual, termasuk tiap varian ukuran/warna/bahan.
// Harga jual tanpa PPN dan hanya acuan: harga yang dipakai tersimpan di baris dokumen (penawaran, proyek).
// Stok tidak disimpan di sini: tiap produk punya satu barang jadi di Inventory (Item.productId).
model Product {
  id        String          @id @default(cuid())
  code      String          @unique // PRD-001 (produk migrasi dari barang jadi lama tetap BJ-001)
  name      String
  category  ProductCategory @default(LAINNYA)
  type      ProductType     @default(PRODUKSI)
  unit      String // unit, set, lembar, ...
  size      String? // ukuran, mis. 120 x 60 x 75 cm
  material  String? // bahan
  spec      String? // spesifikasi lain, satu butir per baris
  price     Decimal         @default(0) @db.Decimal(16, 2) // harga jual acuan, tanpa PPN
  cost      Decimal         @default(0) @db.Decimal(16, 2) // harga pokok, diisi manual
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  item  Item?
  image ProductImage?

  @@index([active, category])
  @@map("products")
}

// Gambar produk, disimpan terpisah seperti logo supaya tidak ikut terbaca di setiap query.
model ProductImage {
  productId String   @id
  data      Bytes
  mime      String // image/png atau image/jpeg
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// Riwayat mutasi stok; tidak pernah diubah atau dihapus (koreksi = mutasi baru).
model StockMovement {
  id             String       @id @default(cuid())
  itemId         String
  type           MovementType
  qty            Decimal      @db.Decimal(14, 3) // bertanda
  balanceAfter   Decimal      @db.Decimal(14, 3)
  note           String?
  // Rujukan ke dokumen/proses asal, mis. refType "PRODUKSI", refId id batch produksi.
  refType        String?
  refId          String?
  // Kunci idempoten: mutasi dengan kunci yang sama hanya tercatat sekali
  // (mencegah QC lulus yang terkirim dua kali menambah stok dua kali).
  idempotencyKey String?      @unique
  userId         String?
  createdAt      DateTime     @default(now())
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@index([refType, refId])
  @@map("stock_movements")
}

// BOM: bahan baku yang dibutuhkan untuk satu unit barang jadi.
model BomLine {
  id         String  @id @default(cuid())
  productId  String
  materialId String
  qty        Decimal @db.Decimal(14, 4) // per 1 unit barang jadi
  product    Item    @relation("BomProduct", fields: [productId], references: [id], onDelete: Cascade)
  material   Item    @relation("BomMaterial", fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([productId, materialId])
  @@map("bom_lines")
}

// ---------------------------------------------------------------------------
// Modul Proyek (pesanan dan produksi)
// ---------------------------------------------------------------------------

// Tahapan produksi. Rangka besi dan potong kayu berjalan paralel; selanjutnya berurutan.
enum Stage {
  RANGKA_BESI
  POTONG_KAYU
  RAKIT
  FINISHING
  QC
  PACKING
  KIRIM
}

enum ProjectKind {
  ORDER // pesanan pelanggan
  STOK // order produksi internal untuk stok, tanpa pelanggan
}

enum ProjectStatus {
  BERJALAN
  SELESAI
  BATAL
}

enum DeliveryStatus {
  RENCANA
  TERKIRIM
  BATAL
}

enum CostCategory {
  BAHAN
  TENAGA
  LAIN
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  contact   String? // nama kontak (PIC)
  phone     String?
  email     String?
  address   String?
  taxId     String? // NPWP
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects   Project[]
  quotations Quotation[]

  @@index([name])
  @@map("customers")
}

model Project {
  id          String        @id @default(cuid())
  code        String        @unique // PRY-2026-001 (pesanan) / STK-2026-001 (produksi stok)
  kind        ProjectKind
  status      ProjectStatus @default(BERJALAN)
  name        String
  companyId   String? // kosong untuk produksi stok
  customerId  String?
  orderRef    String? // nomor KO/PO pelanggan bila ada
  orderDate   DateTime      @default(now())
  dueDate     DateTime? // estimasi selesai kirim
  // PPN diambil dari perusahaan saat proyek dibuat (GTF 0, SBA 11), lalu dibekukan.
  ppnRate     Decimal       @default(0) @db.Decimal(5, 2)
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company    Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines      ProjectLine[]
  deliveries Delivery[]
  costs      ProjectCost[]
  terms      PaymentTerm[]
  salesOrder SalesOrder?
  invoices   Invoice[]
  productionOrder ProductionOrder?

  @@index([status, dueDate])
  @@index([kind, status])
  @@map("projects")
}

// Satu baris pesanan = satu barang jadi dengan jumlahnya.
model ProjectLine {
  id          String  @id @default(cuid())
  projectId   String
  productId   String
  qty         Int
  unitPrice   Decimal @default(0) @db.Decimal(16, 2) // tanpa PPN; 0 untuk produksi stok
  issuedUnits Int     @default(0) // jumlah unit yang bahannya sudah dikeluarkan dari stok
  note        String?
  sort        Int     @default(0)

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product   Item            @relation(fields: [productId], references: [id], onDelete: Restrict)
  stages    ProjectStage[]
  issues    MaterialIssue[]
  qcs       QcRecord[]
  delivered DeliveryLine[]
  soLine    ProductionOrderLine?

  @@index([projectId])
  @@map("project_lines")
}

// Progres satu tahap pada satu baris: `done` unit sudah melewati tahap ini.
model ProjectStage {
  lineId    String
  stage     Stage
  done      Int      @default(0)
  held      Boolean  @default(false) // tertahan (ada kendala)
  holdNote  String?
  updatedAt DateTime @updatedAt

  line ProjectLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@id([lineId, stage])
  @@map("project_stages")
}

// Pemakaian bahan baku untuk sejumlah unit (memanggil issueMaterialsForProduction).
model MaterialIssue {
  id        String   @id @default(cuid())
  lineId    String
  units     Int
  cost      Decimal  @db.Decimal(16, 2) // nilai bahan saat dikeluarkan
  userId    String?
  createdAt DateTime @default(now())

  line ProjectLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("material_issues")
}

// QC lulus: sejumlah unit lulus dan masuk stok barang jadi.
model QcRecord {
  id        String   @id @default(cuid())
  lineId    String
  qty       Int
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  line ProjectLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@map("qc_records")
}

// Pengiriman bertahap: satu proyek bisa punya beberapa pengiriman.
model Delivery {
  id          String         @id @default(cuid())
  projectId   String
  seq         Int // pengiriman ke-n dalam proyek
  plannedDate DateTime?
  shippedAt   DateTime?
  status      DeliveryStatus @default(RENCANA)
  note        String?
  userId      String?
  createdAt   DateTime       @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   DeliveryLine[]

  @@unique([projectId, seq])
  @@map("deliveries")
}

model DeliveryLine {
  id         String @id @default(cuid())
  deliveryId String
  lineId     String
  qty        Int

  delivery Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  line     ProjectLine @relation(fields: [lineId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, lineId])
  @@map("delivery_lines")
}

// Biaya proyek: bahan (otomatis dari stok atau manual), tenaga kerja, lain-lain.
model ProjectCost {
  id          String       @id @default(cuid())
  projectId   String
  category    CostCategory
  description String
  amount      Decimal      @db.Decimal(16, 2)
  // "STOK" bila otomatis dari pemakaian bahan; refId = id MaterialIssue.
  source      String?
  refId       String?      @unique
  incurredAt  DateTime     @default(now())
  userId      String?
  createdAt   DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_costs")
}

// ---------------------------------------------------------------------------
// Modul Dokumen (penawaran, konfirmasi order, invoice, kwitansi)
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  TERKIRIM
  DISETUJUI
  DITOLAK
  BATAL
}

enum InvoiceStatus {
  TERBIT
  BATAL
}

enum PaymentMethod {
  TRANSFER
  TUNAI
  CEK_GIRO
  LAIN
}

// Logo perusahaan disimpan terpisah supaya data besar tidak ikut terbaca di setiap query perusahaan.
model CompanyLogo {
  companyId String   @id
  data      Bytes
  mime      String // image/png atau image/jpeg
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_logos")
}

// Penawaran harga (SPH). Teks bebas; baris boleh dikaitkan ke barang jadi di katalog.
model Quotation {
  id          String          @id @default(cuid())
  companyId   String
  customerId  String
  number      String // SBA.026/SPH/XI/2026
  date        DateTime
  attn        String? // u.p.
  subject     String // perihal
  // PPN dibekukan dari perusahaan saat penawaran dibuat.
  ppnRate     Decimal         @default(0) @db.Decimal(5, 2)
  notes       String? // satu catatan per baris
  status      QuotationStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    QuotationLine[]
  terms    PaymentTerm[]
  order    SalesOrder?

  @@unique([companyId, number])
  @@index([status, date])
  @@map("quotations")
}

model QuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  sort        Int     @default(0)
  description String
  spec        String?
  qty         Int
  unit        String
  unitPrice   Decimal @db.Decimal(16, 2) // tanpa PPN
  productId   String? // barang jadi di katalog; wajib saat diubah menjadi Konfirmasi Order

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Item?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_lines")
}

// Termin pembayaran: milik penawaran, lalu disalin ke proyek saat menjadi Konfirmasi Order.
model PaymentTerm {
  id          String  @id @default(cuid())
  quotationId String?
  projectId   String?
  seq         Int
  label       String // DP, Termin 2, Pelunasan
  trigger     String // Saat KO ditandatangani, Saat barang dikirim, ...
  percent     Decimal @db.Decimal(5, 2)
  dueDays     Int     @default(14) // jatuh tempo invoice, hari setelah terbit

  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@index([quotationId])
  @@index([projectId])
  @@map("payment_terms")
}

// Konfirmasi Order (KO): satu per proyek. Barang dan harga mengikuti baris proyek.
model SalesOrder {
  id               String    @id @default(cuid())
  companyId        String
  projectId        String    @unique
  quotationId      String?   @unique
  number           String // GTF-024/KO/X/2026
  date             DateTime
  deliveryLocation String?
  workDays         Int? // waktu pengerjaan (hari kerja)
  notes            String? // satu catatan per baris
  signedAt         DateTime? // KO ditandatangani pemesan
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  production ProductionOrder?

  @@unique([companyId, number])
  @@map("sales_orders")
}

// Sales Order (SO): tampilan acuan produksi yang terbit otomatis bersama Konfirmasi Order.
// Dilihat Ketua Produksi Kayu, Ketua Produksi Besi, dan Gudang (packing). Tanpa harga.
// Pemesan, alamat, dan tanggal kirim dibaca langsung dari KO dan proyek, jadi tidak bisa berbeda.
// (Model ini bernama ProductionOrder karena SalesOrder di atas sudah dipakai untuk KO.)
model ProductionOrder {
  id        String   @id @default(cuid())
  companyId String
  projectId String   @unique
  orderId   String   @unique // KO asalnya
  number    String // GTF-024/SO/X/2026 (nomor KO dengan KO diganti SO)
  notes     String? // catatan untuk produksi
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order   SalesOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines   ProductionOrderLine[]

  @@unique([companyId, number])
  @@map("production_orders")
}

// Satu barang pada SO. Jumlah dan satuan mengikuti baris proyek; judul dan spesifikasi boleh diubah.
model ProductionOrderLine {
  id            String  @id @default(cuid())
  orderId       String
  projectLineId String  @unique
  sort          Int     @default(0)
  title         String // nama barang seperti tertulis di penawaran
  spec          String? // ukuran, bahan, finishing (teks bebas, satu baris per butir)

  order       ProductionOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  projectLine ProjectLine          @relation(fields: [projectLineId], references: [id], onDelete: Cascade)
  image       ProductionOrderImage?

  @@index([orderId])
  @@map("production_order_lines")
}

// Gambar acuan per barang, disimpan terpisah seperti logo supaya tidak ikut terbaca di setiap query.
model ProductionOrderImage {
  lineId    String              @id
  data      Bytes
  mime      String // image/png atau image/jpeg
  updatedAt DateTime            @updatedAt
  line      ProductionOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@map("production_order_images")
}

// Invoice: satu per termin. Jumlah dibekukan saat terbit.
model Invoice {
  id          String        @id @default(cuid())
  companyId   String
  projectId   String
  termId      String?
  deliveryId  String? // pengiriman yang ditagih (untuk termin "saat barang dikirim")
  number      String // GTF-024/INV/X/2026
  date        DateTime
  dueDate     DateTime
  status      InvoiceStatus @default(TERBIT)
  description String // mis. Uang muka (DP) pesanan GTF-012/KO/XI/2026
  detail      String? // rincian barang
  orderValue  Decimal       @db.Decimal(16, 2) // nilai order tanpa PPN
  percent     Decimal       @db.Decimal(5, 2)
  subtotal    Decimal       @db.Decimal(16, 2)
  ppnRate     Decimal       @db.Decimal(5, 2)
  ppn         Decimal       @db.Decimal(16, 2)
  total       Decimal       @db.Decimal(16, 2)
  voidReason  String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project  Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  term     PaymentTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@unique([companyId, number])
  @@index([projectId])
  @@index([status, dueDate])
  @@map("invoices")
}

// Pembayaran diterima; setiap pembayaran menerbitkan satu kwitansi.
model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  receiptNumber String // GTF-22/KW/X/2026
  date          DateTime
  amount        Decimal       @db.Decimal(16, 2)
  method        PaymentMethod @default(TRANSFER)
  note          String?
  balanceAfter  Decimal       @db.Decimal(16, 2) // sisa tagihan invoice setelah pembayaran ini
  voidedAt      DateTime?
  voidReason    String?
  createdById   String?
  createdAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([date])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Modul Aset (mesin, kendaraan, peralatan)
// ---------------------------------------------------------------------------

enum AssetType {
  MESIN
  KENDARAAN
  PERALATAN
}

enum AssetStatus {
  AKTIF
  PERAWATAN // sedang diservis/diperbaiki
  RUSAK
  DIJUAL // akhir: sudah dijual
  DIHAPUSKAN // akhir: dihapuskan/afkir
}

enum MaintenanceType {
  RUTIN // perawatan berkala
  SERVIS
  PERBAIKAN
}

// Kategori aset beserta umur manfaat bawaan untuk penyusutan garis lurus.
model AssetCategory {
  id               String    @id @default(cuid())
  name             String    @unique
  type             AssetType
  usefulLifeMonths Int       @default(0) // 0 = tidak disusutkan
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  assets Asset[]

  @@map("asset_categories")
}

model Asset {
  id               String      @id @default(cuid())
  code             String      @unique // MSN-001, KDR-001, PRL-001
  companyId        String
  categoryId       String
  name             String
  brand            String?
  serialNumber     String? // no. seri / no. rangka / no. polisi
  location         String?
  status           AssetStatus @default(AKTIF)
  acquiredAt       DateTime    @db.Date
  acquisitionCost  Decimal     @db.Decimal(16, 2)
  salvageValue     Decimal     @default(0) @db.Decimal(16, 2) // nilai sisa
  usefulLifeMonths Int         @default(0) // 0 = tidak disusutkan
  disposedAt       DateTime?   @db.Date
  disposalValue    Decimal?    @db.Decimal(16, 2) // hasil penjualan
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category    AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  maintenance AssetMaintenance[]
  assignments AssetAssignment[]

  @@index([companyId, status])
  @@index([categoryId])
  @@map("assets")
}

// Riwayat perawatan/servis. Tidak diubah setelah dicatat (koreksi = hapus lalu catat ulang oleh Direktur).
model AssetMaintenance {
  id          String          @id @default(cuid())
  assetId     String
  type        MaintenanceType
  performedAt DateTime        @db.Date
  cost        Decimal         @default(0) @db.Decimal(16, 2)
  vendor      String?
  description String
  nextDueAt   DateTime?       @db.Date // jadwal perawatan berikutnya
  userId      String?
  createdAt   DateTime        @default(now())
  asset       Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, performedAt])
  @@index([nextDueAt])
  @@map("asset_maintenance")
}

// Penugasan aset ke orang/bagian. Satu aset hanya punya satu penugasan terbuka (returnedAt kosong).
model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  assignee   String // nama penanggung jawab atau bagian
  assignedAt DateTime  @db.Date
  returnedAt DateTime? @db.Date
  note       String?
  userId     String?
  createdAt  DateTime  @default(now())
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, assignedAt])
  @@map("asset_assignments")
}
